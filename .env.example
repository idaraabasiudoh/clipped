# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare R2 Worker URL (deploy worker/ then paste the URL here)
VITE_R2_WORKER_URL=https://clipped-media.your-account.workers.dev

# Verbose debug logs in production builds too (always on in `npm run dev`).
# You can also toggle at runtime in the browser console: clippedDebug.enable() / .disable()
VITE_DEBUG=false
